# Enforce pnpm as the only package manager for this workspace
# This prevents accidental use of npm or yarn which could corrupt the lockfile

# pnpm specific settings
shamefully-hoist=false
strict-peer-dependencies=true
auto-install-peers=true

# Ensure deterministic installs
lockfile-only=false

# Use exact versions for production dependencies
prefer-frozen-lockfile=true

# NPM registry authentication for CI/CD publishing
# Token is passed via NPM_TOKEN environment variable in GitHub Actions
# This allows automatic publishing via Changesets workflow
registry=https://registry.npmjs.org/
@lexiwind:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
