{
  "name": "@lexiwind/config-eslint",
  "version": "2.0.0",
  "description": "Shared ESLint configuration for Lexiwind packages",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./eslintrc": "./eslintrc.cjs"
  },
  "files": [
    "dist",
    "eslintrc.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTridon/lexiwind.git",
    "directory": "packages/config-eslint"
  },
  "homepage": "https://github.com/ARTridon/lexiwind/tree/main/packages/config-eslint#readme",
  "bugs": {
    "url": "https://github.com/ARTridon/lexiwind/issues"
  },
  "author": "ARTridon",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lexiwind",
    "eslint",
    "config",
    "typescript"
  ]
}
