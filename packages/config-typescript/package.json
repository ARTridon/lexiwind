{
  "name": "@lexiwind/config-typescript",
  "version": "2.0.0",
  "description": "Shared TypeScript configuration for Lexiwind packages",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tsconfig.json": "./tsconfig.base.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTridon/lexiwind.git",
    "directory": "packages/config-typescript"
  },
  "homepage": "https://github.com/ARTridon/lexiwind/tree/main/packages/config-typescript#readme",
  "bugs": {
    "url": "https://github.com/ARTridon/lexiwind/issues"
  },
  "author": "ARTridon",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lexiwind",
    "typescript",
    "config",
    "tsconfig"
  ]
}
