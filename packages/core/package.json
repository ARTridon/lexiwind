{
  "name": "@lexiwind/core",
  "version": "2.0.0",
  "description": "Lexiwind plugin contracts, types, and extension interfaces",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "peerDependencies": {
    "lexical": ">=0.18.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTridon/lexiwind.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ARTridon/lexiwind/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ARTridon/lexiwind/issues"
  },
  "author": "ARTridon",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lexiwind",
    "lexical",
    "editor",
    "react",
    "typescript",
    "plugin",
    "types"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
