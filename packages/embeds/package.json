{
  "name": "@lexiwind/embeds",
  "version": "3.0.0",
  "description": "Unified URL embed plugin for Lexiwind (YouTube, Twitter, Figma, custom)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@lexiwind/core": "workspace:*"
  },
  "peerDependencies": {
    "@lexical/react": ">=0.18.0",
    "@lexical/utils": ">=0.18.0",
    "lexical": ">=0.18.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTridon/lexiwind.git",
    "directory": "packages/embeds"
  },
  "homepage": "https://github.com/ARTridon/lexiwind/tree/main/packages/embeds#readme",
  "bugs": {
    "url": "https://github.com/ARTridon/lexiwind/issues"
  },
  "author": "ARTridon",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lexiwind",
    "lexical",
    "editor",
    "react",
    "embeds",
    "youtube",
    "twitter",
    "figma"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
