{
  "name": "@lexiwind/toolbar",
  "version": "3.0.0",
  "description": "Headless toolbar state hooks and provider for Lexiwind",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@lexiwind/core": "workspace:*"
  },
  "peerDependencies": {
    "@lexical/code": ">=0.18.0",
    "@lexical/link": ">=0.18.0",
    "@lexical/list": ">=0.18.0",
    "@lexical/react": ">=0.18.0",
    "@lexical/rich-text": ">=0.18.0",
    "@lexical/selection": ">=0.18.0",
    "@lexical/table": ">=0.18.0",
    "@lexical/utils": ">=0.18.0",
    "lexical": ">=0.18.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARTridon/lexiwind.git",
    "directory": "packages/toolbar"
  },
  "homepage": "https://github.com/ARTridon/lexiwind/tree/main/packages/toolbar#readme",
  "bugs": {
    "url": "https://github.com/ARTridon/lexiwind/issues"
  },
  "author": "ARTridon",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lexiwind",
    "lexical",
    "editor",
    "react",
    "toolbar",
    "hooks",
    "headless"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
